# URL pública del Worker de API (apps/api).
# Local: el Worker corre en http://localhost:8787 con `wrangler dev`.
# Producción: ya está fijada en `.env.production` (commiteado), que Next.js
# carga solo en builds y le gana a este archivo.
# OJO: NEXT_PUBLIC_* se inlina en BUILD TIME. No se puede cambiar en runtime
# con un `var` de wrangler ni con un secret del Worker.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Cloudflare Access / Zero Trust — protege /panel a nivel de red (ver
# docs/ingenieria/cloudflare-access-panel.md). No secretos, son identificadores
# públicos de la Access Application creada en el dashboard de Zero Trust.
# En local normalmente se dejan vacíos y se usa ACCESS_LOCAL_BYPASS en su lugar.
# En producción viven en el bloque "vars" de wrangler.jsonc, no aquí.
#   CF_ACCESS_TEAM_DOMAIN=thepubmarket.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Escape hatch SOLO para desarrollo local: salta el chequeo de Cloudflare
# Access en /panel cuando no hay forma de emular Access localmente (no hay
# túnel de cloudflared en este repo, y `next dev` no corre a través de un
# Worker). El middleware lo ignora automáticamente si NODE_ENV=production,
# pero NUNCA debe ponerse en `true` en ningún .env que llegue a producción.
ACCESS_LOCAL_BYPASS=true
