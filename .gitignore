# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
.open-next/
.turbo/
out/

# Artefactos intermedios de scripts (p.ej. el SQL de 30 MB que genera
# scripts/import-sepomex.mjs). Se regeneran; nunca se commitean.
.tmp/

# Cloudflare / Wrangler
.wrangler/
.dev.vars
.dev.vars.*
wrangler.local.jsonc

# Env
.env
.env.*
!.env.example
# Excepción: config de BUILD para producción, sin secretos (solo la URL pública
# de la API). Se commitea a propósito para que un build local y uno de CI
# produzcan el mismo bundle — ver apps/web/.env.production.
!.env.production

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Dispatch loop transient state (scripts/dispatch-loop.sh)
CHECKPOINT.md

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code plugin skill cache (auto-downloaded, not project source)
.agents/

# Worktrees efímeros que crea Claude Code para subagentes aislados
.claude/worktrees/

# TypeScript
*.tsbuildinfo

# Next.js
next-env.d.ts
.next-env.d.ts
