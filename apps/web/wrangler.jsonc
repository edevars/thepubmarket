{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thepubmarket-web",
  // Worker generado por OpenNext a partir del build de Next.js.
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },

  // === Config no-secreta ===
  // CF_ACCESS_TEAM_DOMAIN / CF_ACCESS_AUD: identificadores públicos de la
  // Access Application que protege /panel en Cloudflare Zero Trust (NO son
  // credenciales — no autorizan nada por sí solos, solo le dicen a
  // `verifyAccessJwt` contra qué JWKS/audiencia validar el JWT que Access ya
  // puso en el header `Cf-Access-Jwt-Assertion`). Se llenan a mano tras crear
  // la Access Application en el dashboard de Zero Trust — ver
  // docs/ingenieria/cloudflare-access-panel.md para el paso a paso.
  //   - Team domain: Zero Trust → Settings → Custom Pages (o la URL del
  //     equipo, forma `<team-name>.cloudflareaccess.com`).
  //   - AUD tag: la Access Application de /panel → "Application Audience (AUD) Tag".
  // Runtime: OpenNext puebla `process.env` con cada `var`/binding del Worker
  // al inicio de cada request (`populateProcessEnv` en
  // `@opennextjs/cloudflare/dist/cli/templates/init.js`), así que
  // `process.env.CF_ACCESS_TEAM_DOMAIN` funciona tal cual dentro de
  // `src/middleware.ts` — no hace falta `getCloudflareContext().env`. Eso
  // aplica al Worker real (`pnpm preview` / prod); en `next dev` (sin
  // Worker) estas vars se leen del `.env` local vía el loader nativo de
  // Next.js. Ver runbook para el detalle completo.
  // CF_ACCESS_AUD lleva DOS audiencias separadas por coma, una por Access
  // Application: Access solo admite un wildcard entre cada par de diagonales,
  // así que `/panel*` (locale default, sin prefijo) y `/en/panel*` no caben en
  // una sola aplicación. Ambas comparten la policy "Sellers vetted".
  //   1º = "Panel del Vendedor (es)" → thepubmarket.com/panel*
  //   2º = "Panel del Vendedor (en)" → thepubmarket.com/en/panel*
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "thepubmarket.cloudflareaccess.com",
    "CF_ACCESS_AUD": "03db41a9a38e359e66203f604a23e5f036c62a09056f3eb98d02efcbad8d39d7,33e4f7b6d529ce6653917ef81db79f3a94499cacea3c7f1ca64d7e6897256d71"
  }

  // NOTA: NEXT_PUBLIC_API_URL NO va aquí. Las variables NEXT_PUBLIC_* se inlinan
  // en BUILD TIME, no en runtime, así que un `var` de wrangler no llegaría al
  // bundle del cliente. Se configura como variable de entorno del build:
  //   - Local:  apps/web/.env  (ver .env.example)
  //   - Workers Builds / CI:  variable de entorno del paso de build
  // Ver README → "Variables y secrets".
}
